```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
coverage/
htmlcov/
*.log

# Environment
.env
.env.local
.env.*

# Editors
.vscode/
.idea/
*.swp
*.swo
*.tmp

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
.ENV
.python-version
.mypy_cache/
.pytest_cache/

# Node.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Compiled and binary files
*.o
*.obj
*.exe
*.dll
*.so
*.a
*.out

# OS generated files
.DS_Store
Thumbs.db

# Compression
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst
```